# CoreForge environment configuration
# Copy to .env for local development: cp .env.example .env
# On Render, set these as Environment Variables in the dashboard.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database
# Set DATABASE_URL to your Postgres connection string.
# On Render + Neon, copy the pooled or direct connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Leave both unset to fall back to a local SQLite database.
DATABASE_URL=
NEON_DATABASE_URL=

# Media storage (optional)
# Point these at an S3-compatible bucket to persist uploads across deploys.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_STORAGE_REGION_NAME=auto
# AWS_S3_ADDRESSING_STYLE=path
# SERVE_MEDIA_LOCALLY=True

# eSewa ePay (sandbox)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Email (optional SMTP relay)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=True
